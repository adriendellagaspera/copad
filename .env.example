# ── Storage backends ─────────────────────────────────────────────────────────
# App keys below are OPTIONAL: users can also enter them at runtime via the
# in-app Settings (⚙) panel, where they're saved per-browser. Set a key here to
# manage it centrally — it then shows as "managed" and locked in Settings.
#
# Each backend can also be hidden entirely — it won't appear as a pill or in
# Settings — via VITE_ENABLE_<ID> (true/false, case-insensitive; also accepts
# 1/0, yes/no). Useful to keep a newly added backend out of production until
# it's been connected to a real account outside prod.
# VITE_ENABLE_DROPBOX=true
# VITE_ENABLE_PCLOUD=true
# VITE_ENABLE_WEBDAV=true
# VITE_ENABLE_GITHUB=true
# VITE_ENABLE_LOCAL=true
# VITE_ENABLE_GITLAB=false
# VITE_ENABLE_S3=false
# VITE_ENABLE_SHAREPOINT=false
# VITE_ENABLE_GDRIVE=false
# VITE_ENABLE_ONEDRIVE=false

# Dropbox (OAuth 2 PKCE — no backend required)
# Create an app at https://www.dropbox.com/developers/apps
# Permissions needed: files.content.read, files.content.write
VITE_DROPBOX_APP_KEY=

# pCloud (OAuth token — content reads may need the proxy)
# Create an app at https://docs.pcloud.com → My applications
VITE_PCLOUD_CLIENT_ID=

# WebDAV / Nextcloud (Basic auth — requires the CORS proxy below)
# No key needed; credentials are entered at runtime in the UI.

# GitLab (Personal Access Token — commits to a project; native CORS, no proxy)
# Works with gitlab.com and self-hosted instances. Setting a value LOCKS the field.
# Hidden by default (VITE_ENABLE_GITLAB=false above) until connected to a real
# account outside production — set VITE_ENABLE_GITLAB=true to try it.
# VITE_GITLAB_PROJECT=namespace/project
# VITE_GITLAB_HOST=https://gitlab.com          # set for self-hosted GitLab
# VITE_GITLAB_BRANCH=main
# VITE_GITLAB_TOKEN=

# S3-compatible (AWS S3 / Cloudflare R2 / MinIO / Backblaze B2 — bucket must allow CORS)
# No key needed; endpoint, bucket, region, and access keys are entered at runtime.
# Hidden by default (VITE_ENABLE_S3=false above) until connected to a real
# bucket outside production — set VITE_ENABLE_S3=true to try it.
# VITE_S3_PREFIX=copad

# SharePoint / OneDrive for Business (Microsoft Graph — native CORS, no proxy)
# No key needed; a delegated access token + optional site URL are entered at runtime.
# Hidden by default (VITE_ENABLE_SHAREPOINT=false above) until connected to a
# real account outside production — set VITE_ENABLE_SHAREPOINT=true to try it.
# VITE_GRAPH_API_URL=https://graph.microsoft.com/v1.0   # set for a national cloud
# VITE_SHAREPOINT_FOLDER=Documents

# Google Drive (OAuth 2 PKCE — no backend required; drive.file scope)
# Create an OAuth Web App credential at https://console.cloud.google.com and
# enable the Drive API. Users can also paste the Client ID at runtime in Settings.
# Hidden by default (VITE_ENABLE_GDRIVE=false above) until connected to a real
# account outside production — set VITE_ENABLE_GDRIVE=true to try it.
VITE_GDRIVE_CLIENT_ID=

# ── OAuth redirect URI ───────────────────────────────────────────────────────
# Must match the URI registered in each provider's developer console.
# Defaults to http://localhost:5173/redirect.html for local dev.
# VITE_REDIRECT_URI=http://localhost:5173/redirect.html

# ── (Optional) CORS proxy ────────────────────────────────────────────────────
# Required for WebDAV and pCloud content reads.
# Deploy deploy/proxy-worker/ and set ALLOWED_HOSTS there to prevent relay abuse.
# VITE_PROXY_URL=https://your-worker.workers.dev

# ── Collaboration transport ──────────────────────────────────────────────────
# Which real-time transport to use — chosen EXPLICITLY (default: webrtc):
#   webrtc    — peer-to-peer (default). Needs a signaling server (below) + STUN/TURN.
#   websocket — a central y-websocket hub relays the document. No WebRTC, so no
#               STUN/TURN and no NAT traversal — the reliable choice for mobile /
#               restrictive networks. The server is in the data path and sees
#               plaintext, so VITE_ROOM_PASSWORD (E2E) does NOT apply.
# VITE_COLLAB_TRANSPORT=webrtc

# WebRTC signaling server(s), comma-separated (used when transport=webrtc). Peers
# MUST share a reachable signaling server to discover each other. On a deployed
# (https) site this MUST be wss:// (browsers block ws:// as mixed content); the
# ws://localhost default only works in local dev. If unset on a deployed origin,
# real-time collaboration is disabled and the app shows a warning banner.
# VITE_SIGNALING_URL=ws://localhost:4444

# y-websocket hub URL (used when transport=websocket). Must be wss:// on a deployed
# origin. Deploy any upstream y-websocket server — see README "Deploying a
# collaboration server".
# VITE_WEBSOCKET_URL=ws://localhost:1234

# Shared landing room — the room everyone lands in when the URL has no ?room=
# param (all peers sharing a room collaborate in real time). There is NO default:
# leave this unset and a bare visit gets a fresh, private, encrypted room of its
# own instead of a room shared with every other bare visitor.
# VITE_DEFAULT_ROOM=copad-demo

# ── Room access & encryption (WebRTC transport only) ─────────────────────────
# The WebSocket hub relays plaintext; VITE_ROOM_AUTH has no effect there.
#
# VITE_ROOM_AUTH selects how peers are permitted to join a room:
#   public          — no restriction; anyone with the URL joins (default).
#   site-password   — one password for every room, set via VITE_ROOM_PASSWORD.
#                     Useful for closed deployments managed by an operator.
#   room-password   — each room creator types a per-room password; it is
#                     remembered in the browser and shared out-of-band.
#                     A wrong/missing password looks like an empty room.
#   secret-link     — a random key is generated and embedded in the URL #k=
#                     fragment. Anyone with the full link can join and decrypt.
#                     The key never reaches the signaling server (hash = client-only).
#
# Regardless of VITE_ROOM_AUTH, the in-app Share dialog lets a user encrypt the
# current room on the fly — generate a secure link (#k=) or set a room password.
# Effective key precedence at connect: secure-link #k= → per-room password →
# the configured strategy above. VITE_ROOM_PASSWORD remains the deployment fallback.
# VITE_ROOM_AUTH=public

# Deployment-managed password for site-password mode.
# Also accepted as a global fallback when VITE_ROOM_AUTH is not set (legacy).
# VITE_ROOM_PASSWORD=

# ── WebRTC NAT traversal (STUN / TURN) ───────────────────────────────────────
# Only relevant to the default WebRTC transport (not the WebSocket hub above).
# A public STUN server (below) is enough for most home/office networks. Mobile
# carriers and other restrictive networks use symmetric NAT / CGNAT, where STUN
# fails and a TURN relay is required for desktop↔mobile sessions to connect.
#
# Out of the box, when NO TURN is configured Copad falls back to a free PUBLIC
# relay (OpenRelay) so desktop↔mobile "just works" — but it's best-effort and
# rate-limited. For anything serious, set your own TURN below (or at runtime in
# the in-app Settings → Connection panel, which overrides these and the default).
#
# Comma-separated STUN URLs (defaults to Google's public STUN; set empty to disable).
# VITE_STUN_URL=stun:stun.l.google.com:19302
# TURN relay (comma-separated) + username/password. Run e.g. coturn (see the
# deploy/turn/ folder) or use a hosted TURN provider.
# NOTE: VITE_* vars are inlined into the public client bundle at build time, so
# VITE_TURN_PASSWORD is public — readable by anyone who loads the app. Treat it
# as a rotatable key, cap abuse with server-side TURN quotas, and prefer
# time-limited credentials for a hardened deploy — see deploy/turn/README.md.
# VITE_TURN_URL=turns:your-turn-server:5349
# VITE_TURN_USERNAME=
# VITE_TURN_PASSWORD=
#
# Dynamic ICE credentials endpoint. Some TURN providers (e.g. Cloudflare) mint
# SHORT-LIVED credentials from a SECRET API token that must not ship in the client
# bundle — so a tiny server-side endpoint returns fresh { iceServers: [...] } JSON
# instead. Point this at that endpoint (deploy deploy/ice-worker/) and Copad
# fetches TURN creds at startup, in place of the static VITE_TURN_* above. The
# creds auto-rotate (a reload gets fresh ones) and the API token stays server-side.
# A user's own TURN in Settings → Connection still takes precedence.
# VITE_ICE_SERVERS_URL=https://your-turn-credentials.workers.dev
# How long (ms) to wait for that endpoint before falling back to env/default ICE.
# VITE_ICE_FETCH_TIMEOUT_MS=10000

# Which storage backend to connect by default (id: "dropbox", "pcloud", "webdav")
# VITE_STORAGE_BACKEND=dropbox
